# ==============================================================
# MALINA MATRIX — PORTABLE EXAMPLE CONFIGURATION
# Copy this file to zegar.conf and edit it for your hardware.
# Boolean values: true / false.
# Relative paths are resolved from the project directory.
# Invalid values fall back to safe built-in defaults.
# ==============================================================

[modules]
# Core features
sensors = true
history = true
graph = true
weather = true
wifi_indicator = true
web_control = true
messages = true
lamp = true

# Optional features (disabled by default)
audio_visualizer = false
flip_clock = false
info_transitions = false

[hardware]
# Number of chained MAX7219 8x8 modules.
panel_count = 8
block_orientation = -90
rotation = 0
reverse_order = false
i2c_address = 0x76
i2c_port = 1

[clock]
format_24h = true
show_seconds = false

[fonts]
# BDF fonts are bundled with the application.
day = zegar_app/assets/fonts/8-series/MatrixChunky8X.bdf
sensor = zegar_app/assets/fonts/6-series/MatrixChunky6.bdf
night = BUILTIN:TINY_FONT
message = BUILTIN:LCD_FONT
fallback = BUILTIN:LCD_FONT
sensor_fallback = BUILTIN:TINY_FONT
# Put custom BDF fonts in zegar_app/assets/fonts/custom/.

[display]
# Built-in screens: temperature, humidity, pressure, weather.
screen_order = temperature, humidity, pressure, weather
screen_dwell_seconds = 5.0
normal_refresh_seconds = 1.0
message_refresh_seconds = 0.05
animation_refresh_seconds = 0.02
night_mode_enabled = true
night_start_hour = 23
night_end_hour = 6

[brightness]
day_contrast = 1
night_contrast = 0
lamp_default_brightness = 100
lamp_default_density = 100

[sensor]
# Polling runs in the background, not in the display loop.
refresh_seconds = 1.0

[sensors]
# Only listed sensor backends are imported.
# Available built-ins: bme280, ds18b20, sht31, dht22.
enabled = bme280

[sensors.bme280]
address = 0x76
port = 1

[sensors.ds18b20]
device_id = auto

[sensors.sht31]
address = 0x44
port = 1

[sensors.dht22]
pin = D4

[history]
database_path = data/sensor_data.db
web_directory = web
log_interval_seconds = 300
graph_hours = 6
export_on_start = true

[weather]
# Set these coordinates to your location.
# 0.0 / 0.0 are neutral examples, not a useful local forecast.
latitude = 0.0
longitude = 0.0
cache_seconds = 1800
retry_seconds = 300
request_timeout_seconds = 5
display_style = icon

[network]
probe_host = 8.8.8.8
probe_port = 53
probe_timeout_seconds = 2
probe_interval_seconds = 10

[web]
host = 0.0.0.0
port = 8088
message_duration_seconds = 10

[screens]
# Add Python filenames (without .py) from zegar_app/extensions/screens/.
plugins =
plugin_refresh_seconds = 2.0
plugin_stale_seconds = 15.0

[extensions]
# Explicitly enabled modules in zegar_app/extensions/modules/.
modules =

[effects]
flip_seconds = 0.020
flip_frame_seconds = 0.020
info_transition_seconds = 0.14
info_blank_seconds = 0.045
info_frame_seconds = 0.025

[assets]
images_dir = zegar_app/assets/images
