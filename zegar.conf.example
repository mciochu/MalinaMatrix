# ==============================================================
# MALINA MATRIX — PORTABLE CONFIGURATION
# Edit this file and save it. Safe display settings reload automatically.
# Hardware, module, sensor-driver, web-port and extension-list changes
# require a service restart: sudo systemctl restart malina-matrix.service
#
# Boolean values: true / false.
# Relative paths are resolved from the project directory.
# Invalid values are replaced with safe defaults and logged once.
# ==============================================================

[modules]
# Core runtime services
sensors = true
history = true
graph = true
weather = true
wifi_indicator = true
web_control = true
messages = true
lamp = true

# Optional modules. Audio remains disabled by default.
audio_visualizer = false
flip_clock = false
info_transitions = false

[hardware]
panel_count = 8
block_orientation = -90
rotation = 0
reverse_order = false
i2c_address = 0x76
i2c_port = 1

[clock]
format_24h = true
show_seconds = false

[fonts]
# Use a .bdf file path or BUILTIN:LCD_FONT / BUILTIN:TINY_FONT.
# Bundled Matrix fonts are stored inside zegar_app/assets/fonts/.
day = zegar_app/assets/fonts/8-series/MatrixChunky8X.bdf
sensor = zegar_app/assets/fonts/6-series/MatrixChunky6.bdf
night = BUILTIN:TINY_FONT
message = BUILTIN:LCD_FONT
fallback = BUILTIN:LCD_FONT
sensor_fallback = BUILTIN:TINY_FONT
# Place additional BDF files in zegar_app/assets/fonts/custom/.

[display]
# Built-in screens: temperature, humidity, pressure, weather.
# Custom screens are added to this list after their plugin is enabled below.
screen_order = temperature, humidity, pressure, weather
screen_dwell_seconds = 5.0
normal_refresh_seconds = 1.0
message_refresh_seconds = 0.05
animation_refresh_seconds = 0.02
night_mode_enabled = true
night_start_hour = 23
night_end_hour = 6

[brightness]
# Preserve the existing display intensity.
day_contrast = 1
night_contrast = 0
lamp_default_brightness = 100
lamp_default_density = 100

[sensor]
# Sensor polling happens on a dedicated worker, never on the display loop.
refresh_seconds = 1.0

[sensors]
# Add backend names here; only listed backends are imported.
# Available built-ins: bme280, ds18b20, sht31, dht22.
enabled = bme280

[sensors.bme280]
address = 0x76
port = 1

[sensors.ds18b20]
# Use "auto" to select the first detected 1-Wire device.
device_id = auto

[sensors.sht31]
address = 0x44
port = 1

[sensors.dht22]
# CircuitPython board pin name, e.g. D4.
pin = D4

[history]
database_path = data/sensor_data.db
web_directory = web
log_interval_seconds = 300
graph_hours = 6
export_on_start = true

[weather]
latitude = 0.0  # Replace with your location before using the weather screen.
longitude = 0.0
cache_seconds = 1800
retry_seconds = 300
request_timeout_seconds = 5
display_style = icon

[network]
probe_host = 8.8.8.8
probe_port = 53
probe_timeout_seconds = 2
probe_interval_seconds = 10

[web]
host = 0.0.0.0
port = 8088
message_duration_seconds = 10

[screens]
# Add plugin filenames (without .py), separated by commas.
# Example: plugins = example_status
plugins =
plugin_refresh_seconds = 2.0
plugin_stale_seconds = 15.0

[extensions]
# Optional background extensions in zegar_app/extensions/modules/.
# Keep empty unless you explicitly install and trust an extension.
modules =

[effects]
flip_seconds = 0.020
flip_frame_seconds = 0.020
info_transition_seconds = 0.14
info_blank_seconds = 0.045
info_frame_seconds = 0.025


[layout]
# Coordinates use the physical 64x8 LED canvas. X: 0-63, Y: 0-7.
# Move the origin of each element; the content keeps its original dimensions.
weather_icon_x = 20
weather_icon_y = 0
temperature_x = 31
temperature_y = 2
precipitation_icon_x = 48
precipitation_icon_y = 0
precipitation_bar_x = 47
precipitation_bar_y = 0
graph_x = 20
graph_y = 7
info_value_x = 41
info_value_y = 3
wifi_x = 63
wifi_y = 0
clock_offset_x = 0
clock_offset_y = 0

[assets]
# Add 1-bit JSON bitmap images to this directory.
images_dir = zegar_app/assets/images